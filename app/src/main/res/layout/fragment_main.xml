<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_margin="16dp"
    android:orientation="vertical">

    <!-- Верхняя панель с датой и кнопкой + -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:minHeight="50dp">

        <TextView
            android:id="@+id/date_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.65"
            android:minHeight="48dp"
            android:gravity="center"
            android:clickable="true"
            android:textSize="16sp"
            android:text="Выбрать даты" />

        <ImageView
            android:id="@+id/add_new"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.25"
            android:minHeight="50dp"
            android:clickable="true"
            android:src="@drawable/baseline_add_box_24"
            app:tint="@color/accent" />

        <ImageView
            android:id="@+id/btn_toggle_chart"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.25"
            android:minHeight="50dp"
            android:clickable="true"
            android:src="@drawable/baseline_pie_chart_24"
            app:tint="@color/accent" />
    </LinearLayout>

    <!-- RecyclerView с диаграммами -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_diagrams"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        tools:itemCount="3"
        tools:listitem="@layout/item_diagrams" />

    <!-- Заглушка -->
    <LinearLayout
        android:id="@+id/emptyState"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Данные не обнаружены"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/black" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Загрузите банковскую выписку"
            android:textSize="16sp"
            android:textColor="@color/dark_grey"
            android:layout_marginTop="12dp"
            android:textAlignment="center" />
    </LinearLayout>

</LinearLayout>