<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_margin="30dp">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.25">
    </androidx.constraintlayout.widget.Guideline>

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        app:layout_constraintTop_toTopOf="@id/guideline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/liner_with_edit_texts"

        android:layout_marginVertical="40dp"

        android:text="Регистрация"
        android:textAlignment="center"
        android:textStyle="bold"
        android:textSize="20sp">
    </TextView>

    <LinearLayout
        android:id="@+id/liner_with_edit_texts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/title"
        app:layout_constraintBottom_toTopOf="@id/button_to_auth"
        android:orientation="vertical">

        <EditText
            android:id="@+id/edit_text_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:minHeight="60dp"

            android:hint="Email">
        </EditText>

        <EditText
            android:id="@+id/edit_text_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:minHeight="60dp"
            android:hint="Пароль">
        </EditText>

    </LinearLayout>

    <TextView
        android:id="@+id/button_to_auth"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="48dp"

        android:text="Авторизация"

        android:clickable="true"

        app:layout_constraintTop_toBottomOf="@id/liner_with_edit_texts"
        app:layout_constraintEnd_toEndOf="@id/liner_with_edit_texts"

        android:textColor="@color/blue"
        android:textStyle="bold"
        android:textSize="14dp">
    </TextView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/bt_to_registration"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        app:layout_constraintTop_toBottomOf="@id/button_to_auth"
        app:layout_constraintStart_toStartOf="parent"

        android:minHeight="50dp"

        android:text="Зарегистрироваться"
        android:backgroundTint="@color/blue">
    </com.google.android.material.button.MaterialButton>

</androidx.constraintlayout.widget.ConstraintLayout>