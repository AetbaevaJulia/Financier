<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/startFragment">

    <fragment
        android:id="@+id/mainFragment"
        android:name="com.example.financier.presenter.fragments.MainFragment"
        android:label="MainFragment">

        <action
            android:id="@+id/action_mainFragment_to_operationsInCategoryFragment"
            app:destination="@id/operationsInCategoryFragment" />

    </fragment>
    <fragment
        android:id="@+id/authFragment"
        android:name="com.example.financier.presenter.fragments.AuthFragment"
        android:label="AuthFragment" >
        <action
            android:id="@+id/action_authFragment_to_mainFragment"
            app:destination="@id/mainFragment" />
        <action
            android:id="@+id/action_authFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
    </fragment>
    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.financier.presenter.fragments.RegisterFragment"
        android:label="RegisterFragment" >
        <action
            android:id="@+id/action_registerFragment_to_mainFragment"
            app:destination="@id/mainFragment" />
        <action
            android:id="@+id/action_registerFragment_to_authFragment"
            app:destination="@id/authFragment" />
    </fragment>

    <fragment
        android:id="@+id/operationsInCategoryFragment"
        android:name="com.example.financier.presenter.fragments.OperationsInCategoryFragment"
        android:label="OperationsInCategoryFragment">

        <argument
            android:name="category"
            app:argType="string" />

        <argument
            android:name="subcategory"
            app:argType="string"
            app:nullable="true" />

    </fragment>
    <fragment
        android:id="@+id/startFragment"
        android:name="com.example.financier.presenter.fragments.StartFragment"
        android:label="StartFragment" >
        <action
            android:id="@+id/action_startFragment_to_authFragment"
            app:destination="@id/authFragment" />
        <action
            android:id="@+id/action_startFragment_to_mainFragment"
            app:destination="@id/mainFragment" />
    </fragment>


</navigation>